-- Created a cte to check what Rows are duplicate by partition by every coloumn 
WITH duplicate_cte AS(
SELECT *,
ROW_NUMBER() OVER(
PARTITION BY Retailer, Retailer_id, Invoice_date,Region, State, City, Product, Price_per_unit, 
Units_sold, Total_Sales, Operating_profit, Operating_margin, Sales_Method) AS row_num
FROM adidas_us_sales_messy)
SELECT * 
FROM duplicate_cte
WHERE row_num > 1;

